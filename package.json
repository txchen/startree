{
  "name": "startree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:worker": "vp build && cf dev --mode local",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "vue-tsc --build --force && tsc --project tsconfig.server.json --noEmit",
    "check": "vp run format:check && vp run lint && vp run typecheck",
    "test": "vp test --run && node --test scripts/*.test.mjs",
    "build": "vp build",
    "types": "node scripts/generate-worker-types.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:config": "node scripts/verify-environments.mjs",
    "verify:local": "node scripts/verify-local-worker.mjs",
    "verify:performance-data": "node scripts/verify-performance-data.mjs",
    "verify": "vp run --concurrency-limit 4 verify:all",
    "measure:preview": "node scripts/measure-preview.mjs",
    "performance:prepare:preview": "node scripts/prepare-preview-performance.mjs",
    "access:capture:preview": "node scripts/capture-access-state.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "hono": "^4.9.2",
    "minisearch": "^7.2.0",
    "valibot": "^1.1.0",
    "vue": "^3.5.18",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cf": "1.0.0-beta.12",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "typescript": "6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "^0.2.9",
    "vue-tsc": "^3.3.10",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.5.2"
}
